# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser. Never commit real values.

# --- Alvin: contract, Supabase, server ---

# Base URL for share links; links take the form ${SITE_URL}/v/${slug}
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chain ID for BSC Testnet
NEXT_PUBLIC_CHAIN_ID=97

# Primary public BSC Testnet RPC endpoint
NEXT_PUBLIC_RPC_URL_PRIMARY=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Fallback public BSC Testnet RPC endpoint, a different provider from the primary
NEXT_PUBLIC_RPC_URL_FALLBACK=https://bsc-testnet.publicnode.com

# CampusCred on BSC Testnet (verified on BscScan)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xeaB106368d62bb62956da2881F42e07C8f2279Dc

# Keep true until CP2; the read client uses this flag to choose mock data
NEXT_PUBLIC_USE_MOCK_CHAIN=true

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key; server only, never in client code
SUPABASE_SERVICE_ROLE_KEY=

# Salt for student references; server only, never in the frontend bundle or the repo
STUDENT_REF_SALT=

# Shared secret that protects POST /api/sync
SYNC_SECRET=

# Deployer key for hardhat/ only. TESTNET KEY ONLY, never a mainnet key
DEPLOYER_PRIVATE_KEY=

# BscScan API key for hardhat/ only
BSCSCAN_API_KEY=

# Password for the sample students created by scripts/seed-students.ts; share privately
DEMO_STUDENT_PASSWORD=

# Demo issuer wallet that scripts/seed-students.ts writes to the issuers table
DEMO_ISSUER_WALLET=

# --- Gil: add your block below ---

# Gil: no new variables. The verify and student screens use the shared
# NEXT_PUBLIC_* values above; set NEXT_PUBLIC_USE_MOCK_CHAIN=false at CP2.
